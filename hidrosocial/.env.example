# Contenido base de Obsidian. Compose lo monta en /vault en solo lectura.
VAULT_PATH=..
PORT=3000

# Docker Compose: define una contraseña aleatoria antes de arrancar.
# No subas .env a Git. Por ejemplo, genera una con: openssl rand -hex 32
POSTGRES_DB=calidad
POSTGRES_USER=calidad
POSTGRES_PASSWORD=
CALIDAD_IMAGE_TAG=local

# Desarrollo sin Docker: configura UNA de estas alternativas si tienes
# PostgreSQL accesible. Sin conexión configurada, la web es de solo lectura.
# Compose ya proporciona PGHOST/PGPORT/PGUSER/PGDATABASE/PGPASSWORD al contenedor;
# no publica el puerto 5432 en el equipo anfitrión.

# Alternativa A: cadena de conexión. Codifica caracteres especiales de usuario
# y contraseña como componentes de URL.
# DATABASE_URL=postgresql://usuario:CLAVE_CODIFICADA@servidor:5432/calidad

# Alternativa B: campos separados; la contraseña no requiere codificación URL.
# PGHOST=servidor
# PGPORT=5432
# PGUSER=calidad
# PGDATABASE=calidad
# PGPASSWORD=CLAVE
