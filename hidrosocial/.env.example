# Contenido base de Obsidian. Compose lo monta en /vault en solo lectura.
VAULT_PATH=..
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# 1. ACCESO — obligatorio. Sin esto la web arranca cerrada para todo el mundo
#    y /acceso explica qué falta. No subas .env a Git.
# ─────────────────────────────────────────────────────────────────────────────

# Firma la cookie de sesión. Mínimo 32 caracteres. Genera uno con:
#   bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Admite varios separados por coma para rotarlo sin cerrar las sesiones abiertas:
# el primero firma, los demás siguen validando.
SESSION_SECRET=

# ── LA CUENTA ROOT: la tuya. Es la única que vive aquí; a los demás los das de
#    alta desde el panel (/usuarios), y ésos se guardan en PostgreSQL.

# Nombre con el que entras (letras, dígitos, punto, guion y guion bajo).
ROOT_USUARIO=root
# Correo de la cuenta: también sirve para entrar, y es el remite de tus avisos.
ROOT_CORREO=aguaCalidad@calidad.com
# ⬇⬇⬇  AQUÍ VA TU CONTRASEÑA  ⬇⬇⬇  (mínimo 12 caracteres, en claro)
ROOT_CLAVE=
# Si prefieres no dejarla en claro, borra la línea de arriba y pon aquí su
# derivación, que imprime `bun run clave root`. Ésta gana si están las dos.
# ROOT_CLAVE_HASH=

# Duración de la sesión en horas (1 a 168). Al vencer se pide la clave otra vez.
SESION_HORAS=8

# ─────────────────────────────────────────────────────────────────────────────
# 2. CORREO — el servidor entrega por su propio relay; no hace falta una cuenta
#    de Gmail ni credenciales. Si no hay relay, el alta funciona igual y el
#    panel enseña la contraseña para entregarla a mano.
# ─────────────────────────────────────────────────────────────────────────────

# Remite de los avisos. Puede ser una dirección del propio dominio.
CORREO_REMITENTE=aguaCalidad@calidad.com
# Relay local. Cámbialos sólo si el servidor de correo no está en la misma máquina.
SMTP_HOST=localhost
SMTP_PORT=25
# Sólo para Docker: dentro del contenedor `localhost` es el propio contenedor.
# Deja host.docker.internal si el relay corre en el anfitrión; ponlo a `localhost`
# si instalas el MTA dentro de la imagen.
SMTP_HOST_DOCKER=host.docker.internal
# Nombre con el que la app se presenta al relay (EHLO).
CORREO_DOMINIO=calidad.local
# Ponlo en 0 para no enviar nada y entregar las contraseñas siempre a mano.
CORREO_ENVIAR=1

# ─────────────────────────────────────────────────────────────────────────────
# 3. BASE DE DATOS — guarda el padrón de usuarios y la evidencia capturada.
# ─────────────────────────────────────────────────────────────────────────────

# Docker Compose: define una contraseña aleatoria antes de arrancar.
# Por ejemplo, genera una con: openssl rand -hex 32
POSTGRES_DB=calidad
POSTGRES_USER=calidad
POSTGRES_PASSWORD=
CALIDAD_IMAGE_TAG=local

# ─────────────────────────────────────────────────────────────────────────────
# 4. OPCIONALES
# ─────────────────────────────────────────────────────────────────────────────

# Ponlo en 1 sólo si hay un proxy inverso de confianza delante (nginx, Traefik):
# habilita leer X-Forwarded-For y X-Forwarded-Proto, que de otro modo cualquiera
# puede falsificar para saltarse el freno de intentos.
# CONFIAR_PROXY=1

# Cuentas extra sin base de datos, por si alguna vez corres sin PostgreSQL.
# Formato usuario=derivada, separadas por ";". Se generan con `bun run clave`.
# AUTH_USUARIOS=

# Desarrollo sin Docker: configura UNA de estas alternativas si tienes
# PostgreSQL accesible. Sin conexión configurada, la web es de solo lectura y
# el padrón se reduce a la cuenta root.
# Compose ya proporciona PGHOST/PGPORT/PGUSER/PGDATABASE/PGPASSWORD al contenedor;
# no publica el puerto 5432 en el equipo anfitrión.

# Alternativa A: cadena de conexión. Codifica caracteres especiales de usuario
# y contraseña como componentes de URL.
# DATABASE_URL=postgresql://usuario:CLAVE_CODIFICADA@servidor:5432/calidad

# Alternativa B: campos separados; la contraseña no requiere codificación URL.
# PGHOST=servidor
# PGPORT=5432
# PGUSER=calidad
# PGDATABASE=calidad
# PGPASSWORD=CLAVE
